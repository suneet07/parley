# Copy to .env and fill in. Never commit .env.

# Which business to run
BUSINESS_CONFIG=examples/kettle-and-co/business.yaml
# Public URL for Twilio webhooks (ngrok/cloudflared URL in dev)
PUBLIC_BASE_URL=http://localhost:8000

# LLM fallback chain, tried in order (skips providers with no key)
LLM_CHAIN=groq,cerebras,gemini,openai
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Speech
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=

# Telephony
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Storage
DATABASE_URL=sqlite+aiosqlite:///./parley.db
# DATABASE_URL=postgresql+asyncpg://parley:parley@localhost:5432/parley
REDIS_URL=redis://localhost:6379

# Observability (optional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
OTEL_EXPORTER_OTLP_ENDPOINT=

TENANT_ID=default

# Outbound calling & compliance
COMPLIANCE_REGION=in
OUTBOUND_WEBHOOK_SECRET=
OUTBOUND_MAX_CONCURRENT=3
OUTBOUND_DAILY_CAP_PER_NUMBER=200
OUTBOUND_DAILY_CAP_PER_CONTACT=2
OUTBOUND_MAX_ATTEMPTS=3
OUTBOUND_SMS_FALLBACK=true
